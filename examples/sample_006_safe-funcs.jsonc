{
    "name": "sample-006-safe-funcs",
    "dump_dir" : "{var.work_dir}/dump/{wf.name}/",
    "graph": [
        {
            "name": "pass_01",
            "job": "flow.Pass",
            "parameters" : [
                {"id": 1, "name": "A", "category": 103},
                {"id": 2, "name": "B", "category": 101},
                {"id": 3, "name": "C", "category": 103}
            ]
        },
        {
            "name": "pass_02",
            "job": "flow.Pass",
            "precondition" : "max(10, 20, 30) < abs(-100)",
            "parameters" : {
                "len"       : "{len(output.pass_01)}",
                "type"      : "{type(output.pass_01[0])}",
                "round"     : "{round(123.456, 0)}",
                "floor"     : "{floor(123.456, 2)}",
                "ceil"      : "{ceil(123.456, 2)}",
                "lookup1"   : "{lookup(output.pass_01, criteria={'category':103})}",
                "lookup2"   : "{lookup(output.pass_01, criteria={'category':103}, column=['id', 'name'])}",
                "lookup3"   : "{lookup(output.pass_01, criteria={'category':103}, column=['id'])}",
                "lookup4"   : "{lookup(output.pass_01, criteria={'category':103}, column='id')}"
            }
        }
    ]
}