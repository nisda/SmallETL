{
    "name": "sample-002-pass",
    "dump_dir" : "{var.work_dir}/dump/{wf.name}/",
    "graph": [
        {
            "name": "pass_01",
            "job": "flow.Pass",
            "parameters" : {
                "dummy_1" : "DUMMY1",
                "dummy_2" : "DUMMY2",
                "now" : "{wf.start_time:%Y-%m-%d %H:%M:%S.%f}"
            }
        },
        {
            "name": "pass_02",
            "job": "flow.Pass",
            "parameters" : [
                "DUMMY1",
                "DUMMY2",
                {"pass_01_result": "{payload.pass_01}"} 
            ]
        },
        {
            "name": "pass_03",
            "job": "flow.Pass",
            "parameters" : "{payload.pass_02[0]}"
        }
    ]
}