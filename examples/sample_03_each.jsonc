{
    "name": "sample-03-each",
    "const" : {
        "a": "{var.work_dir}",
        "b": "{wf.run_id}"
    },
    "dump_dir" : "{var.work_dir}/dump/{wf.name}/",
    "graph": [
        {
            "name": "each_01",
            "flow": "each",
            "items": {"x": "XXX", "y": "YYY"},
            "graph" : [
                {
                    "name": "pass_01",
                    "job": "flow.Pass",
                    "parameters" : {
                        "dummy_1" : "{const.a} | {const.b}",
                        "dummy_2" : "{each.index} | {each.key} | {each.value}"
                    }
                },
                {
                    "name": "pass_02",
                    "job": "flow.Pass",
                    "parameters" : [
                        "{const.a} | {const.b}",
                        "{each.index} | {each.key} | {each.value}"
                    ]
                }
            ]
        }
    ]
}