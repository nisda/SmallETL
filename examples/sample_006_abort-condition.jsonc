{
    "name": "sample-006-stop",
    "const" : {
        // 各タスクの condition で判定につかう定数。ここを変えればそのタスクで中止される。
        "abort_task": "pass_01_A"
    },
    "dump_dir" : "{var.work_dir}/dump/{wf.name}/",
    "graph": [
        {
            "name": "pass_01",
            "job": "flow.Pass",
            "parameters" : {
                "aaa" : "AAA"
            },
            "abort" : [
                //  複数の abort 条件で判定可能。１つずつ判定する（OR条件）
                {
                    "condition": "const.abort_task == 'pass_01_A'",
                    "message"  : "*** const 指定により停止されました。"
                },
                {
                    "condition": "const.abort_task == 'pass_01_B'"
                }
            ]
        },
        {
            "name": "each_01",
            "flow": "each",
            "items": {"x": "XXX", "y": "YYY"},
            "graph" : [
                {
                    "name": "each_pass_01",
                    "job": "flow.Pass",
                    "description" : "ループの中でもabortすればそこで打ち切り",
                    "parameters" : {
                        "each" : "{each.index} | {each.key} | {each.value}"
                    },
                    "abort" : {
                        // each の中でも abort 条件に合致すればそこで打ち切り
                        "condition": "const.abort_task == 'each_pass_01'"
                    }
                },
                {
                    "name": "each_pass_02",
                    "job": "flow.Pass",
                    "parameters" : [
                        "{each.index} | {each.key} | {each.value}"
                    ],
                    "abort" : {
                        // each の中でも abort 条件に合致すればそこで打ち切り
                        "condition": "const.abort_task == 'each_pass_02'"
                    }
                }
            ],
            "abort" : {
                // ループが終わったら判定される。
                "condition": "const.abort_task == 'each_01'"
            }
        },
        {
            "name": "pass_02",
            "job": "flow.Pass",
            "parameters" : {
                "bbb" : "BBB"
            },
            "abort" : {
                //  変数も使える
                "condition": "const.abort_task == 'pass_02'",
                "message"  : "処理中止！  `{const.abort_task}` <- 変数も使えるよ"
            }
        },
        {
            "name": "pass_03",
            "job": "flow.Pass",
            "parameters" : {
                "result" : {
                    "code" : -1,
                    "msg"  : "pass_03 で異常終了が発生",
                    "msg2" : "ということにしておく。"
                }
            },
            "abort" : {
                //  変数 ret で、このタスクの結果も参照できる。
                "condition": "ret.result.code != 0",
                "message"  : "[exit={ret.result.code}] {ret.result.msg}"
            }
        }
    ]
}