{
    "name": "sample-006-stop",
    "const" : {
        "abort_task": "each_01"  // 各タスクの abort_condition で判定。ここを変えれば、そこで中止される。
    },
    "dump_dir" : "{var.work_dir}/dump/{wf.name}/",
    "graph": [
        {
            "name": "pass_01",
            "job": "flow.Pass",
            "parameters" : {
                "aaa" : "AAA"
            },
            "abort_condition": "const.abort_task == 'pass_01'",
            "abort_message"  : "*** const 指定により停止されました。"
        },
        {
            "name": "each_01",
            "flow": "each",
            "items": {"x": "XXX", "y": "YYY"},
            "graph" : [
                {
                    "name": "each_pass_01",
                    "job": "flow.Pass",
                    "parameters" : {
                        "each" : "{each.index} | {each.key} | {each.value}"
                    },
                    "abort_condition": "const.abort_task == 'each_pass_01'"
                },
                {
                    "name": "each_pass_02",
                    "job": "flow.Pass",
                    "parameters" : [
                        "{each.index} | {each.key} | {each.value}"
                    ],
                    "abort_condition": "const.abort_task == 'each_pass_02'"
                }
            ],
            "abort_condition": "const.abort_task == 'each_01'"
        },
        {
            "name": "pass_02",
            "job": "flow.Pass",
            "parameters" : {
                "bbb" : "BBB"
            },
            "abort_condition": "const.abort_task == 'pass_02'",
            "abort_message"  : "*** const 指定により停止されました。"
        }
    ]
}